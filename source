local function findOfficeZone()
    local shells = workspace:FindFirstChild("OfficeShellsNEW")
    if not shells then return nil end
    for _, dept in ipairs(shells:GetChildren()) do
        if dept:IsA("Folder") then
            for _, tier in ipairs(dept:GetChildren()) do
                if tier:IsA("Folder") then
                    for _, office in ipairs(tier:GetChildren()) do
                        if office:IsA("Folder") then
                            local z = office:FindFirstChild("OfficeZone")
                            if z then return z end
                        end
                    end
                end
            end
        end
    end
    return nil
end

