-- HYBRID HOOK
local lastSeen = {}

local function dedupe(userId, text)
    local prev = lastSeen[userId]
    local now = tick()
    if prev and prev.text == text and (now - prev.time) < 0.5 then
        return false
    end
    lastSeen[userId] = { text = text, time = now }
    return true
end

pcall(function()
    TextChatService.MessageReceived:Connect(function(msg)
        if not msg or not msg.TextSource then return end
        local userId = msg.TextSource.UserId
        local name = msg.TextSource.Name or msg.TextSource.DisplayName or "Unknown"
        local text = msg.Text or ""
        if dedupe(userId, text) then
            handleMessage(name, text, userId)
        end
    end)
end)

local function attachChatted(plr)
    plr.Chatted:Connect(function(msg)
        if dedupe(plr.UserId, msg) then
            handleMessage(plr.Name, msg, plr.UserId)
        end
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    attachChatted(plr)
end

Players.PlayerAdded:Connect(attachChatted)

