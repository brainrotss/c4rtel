local function getTargetPositions(targetPlayer, spacing, yOffset)
    if not targetPlayer or not targetPlayer.Character then return nil end
    local char = targetPlayer.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local basePos = hrp.Position
    local pos1 = Vector3.new(basePos.X, basePos.Y + 0.5, basePos.Z)
    local mode = "Right"
    local modeName = dirBtn.Text:match("▶ (%w+)")
    if modeName then mode = modeName end
    if mode == "Above" then
        local head = char:FindFirstChild("Head")
        local origin = head and head.Position or basePos
        return pos1, Vector3.new(origin.X, origin.Y + yOffset, origin.Z)
    end
    if mode == "Beneath" then
        return pos1, Vector3.new(basePos.X, basePos.Y + yOffset, basePos.Z)
    end
    local cframe = hrp.CFrame
    local forward = cframe.LookVector
    local right = cframe.RightVector
    local offsetVec
    if mode == "Right" then offsetVec = right * spacing
    elseif mode == "Left" then offsetVec = -right * spacing
    elseif mode == "Front" then offsetVec = forward * spacing
    elseif mode == "Back" then offsetVec = -forward * spacing
    else offsetVec = Vector3.new(spacing, 0, 0) end
    offsetVec = Vector3.new(offsetVec.X, 0, offsetVec.Z)
    return pos1, Vector3.new(
        basePos.X + offsetVec.X,
        basePos.Y + yOffset,
        basePos.Z + offsetVec.Z
    )
end

