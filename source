local function getSpiralPositions(center, spacing, count)
    local positions = {}
    local x, z = 0, 0
    local dx, dz = 0, -1
    for i = 1, count do
        positions[i] = center + Vector3.new(x * spacing, 0, z * spacing)
        if (x == z) or (x < 0 and x == -z) or (x > 0 and x == 1 - z) then
            local t = dx; dx = -dz; dz = t
        end
        x = x + dx; z = z + dz
    end
    return positions
end

local function spawnAllUIDs(origin)
    if not OfficeAction then setStatus("No remote"); return end
    placedItems = {}
    local positions = getSpiralPositions(origin, 5, 100)
    local placed, failed = 0, 0
    for i = 1, 100 do
        local pos = positions[i]
        if not pos then break end
        local uidStr = tostring(i)
        local ok = pcall(function()
            fireRemote(OfficeAction, "PlaceFurniture", {
                targetPart = floorPart, uid = uidStr,
                hitPosition = pos, rotationY = 0,
                ghostCFrame = CFrame.new(pos),
                hitNormal = Vector3.new(0, 1, 0)
            })
        end)
        if ok then
            placed = placed + 1
            table.insert(placedItems, { uid = uidStr, pos = pos })
        else
            failed = failed + 1
        end
        task.wait(0.05)
    end
    setStatus("Placed: " .. placed .. " | Failed: " .. failed)
end

