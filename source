    valueLbl.Font = Theme.FONT
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.Parent = row
    bindTheme(valueLbl, "TextColor3", "TEXT")

    local value = math.clamp(default, minVal, maxVal)
    local dragging = false

    local function updateFromX(x)
        local relX = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = minVal + relX * (maxVal - minVal)
        if maxVal <= 1 then
            value = math.floor(value * 1000) / 1000
            valueLbl.Text = string.format("%.2f", value)
        else
            value = math.floor(value + 0.5)
            valueLbl.Text = tostring(value)
        end
        local scale = (value - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(scale, 0, 1, 0)
        if onChange then onChange(value) end
    end

    local function setValue(v)
        value = math.clamp(v, minVal, maxVal)
        if maxVal <= 1 then
            value = math.floor(value * 1000) / 1000
            valueLbl.Text = string.format("%.2f", value)
        else
            value = math.floor(value + 0.5)
            valueLbl.Text = tostring(value)
        end
        local scale = (value - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(scale, 0, 1, 0)
        if onChange then onChange(value) end
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local initScale = (value - minVal) / (maxVal - minVal)
    fill.Size = UDim2.new(initScale, 0, 1, 0)

    return { setValue = setValue, getValue = function() return value end }
end

