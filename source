local function classifyColor(sender, text)
    if sender == player.Name then return Color3.fromRGB(120, 220, 150) end
    if not text or text == "" then return Theme.TEXT end
    local firstChar = text:sub(1, 1)
    local firstTwo = text:sub(1, 2)
    local firstSeven = text:sub(1, 7)
    local firstFive = text:sub(1, 5)
    if firstChar == ":" or firstChar == ";" then
        return Color3.fromRGB(255, 100, 100)
    elseif firstTwo == "/w" or firstSeven == "/whisper" or firstFive == "/team" or firstTwo == "/t" then
        return Color3.fromRGB(120, 160, 255)
    end
    return Theme.TEXT
end

