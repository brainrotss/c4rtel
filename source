local function applyTheme()
    for _, b in ipairs(_G.Prism_themeBindings or {}) do
        pcall(function()
            b.instance[b.prop] = Theme[b.key]
        end)
    end
end

local function applyPreset(p)
    Theme.BG            = p.bg
    Theme.SURFACE       = p.surface
    Theme.SURFACE_ALT   = p.surfaceAlt
    Theme.SURFACE_HOVER = p.surfaceAlt:Lerp(Color3.new(1, 1, 1), 0.15)
    Theme.ACCENT        = p.accent
    Theme.ACCENT_DARK   = p.accent:Lerp(Color3.new(0, 0, 0), 0.3)
    Theme.TEXT          = p.text
    Theme.TEXT_DIM      = p.dim
    Theme.TEXT_MUTED    = p.dim:Lerp(p.surface, 0.4)
    applyTheme()
    setStatus("Theme: " .. p.name)
    saveConfig()
end

