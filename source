local function trySelectRole(dept, role)
    lastSelectResponse = nil
    roleChangedSignal = false
    UpdateRole:FireServer("SelectRole", dept, role, true)

    local start = tick()
    while tick() - start < 6 do
        if lastSelectResponse then
            if lastSelectResponse.Success then return true, nil end
            return false, tostring(lastSelectResponse.Reason or "unknown")
        end
        if roleChangedSignal then
            return true, nil
