local function readCashLeaderboard()
    local byUserId = {}
    local lb = workspace:FindFirstChild("ServerRichestPlayersLeaderboard")
    if not lb then return byUserId end
    local sg = lb:FindFirstChild("SurfaceGui")
    local sf = sg and sg:FindFirstChild("ScrollingFrame")
    if not sf then return byUserId end
    for _, entry in ipairs(sf:GetChildren()) do
        if entry.Name:match("^Player_%d+") then
            local cashLbl = entry:FindFirstChild("CashAmount")
            local imgLbl = entry:FindFirstChild("ImageLabel")
            if cashLbl and cashLbl:IsA("TextLabel")
                and imgLbl and imgLbl:IsA("ImageLabel") then
                local uidStr = string.match(imgLbl.Image, "id=(%d+)")
                local uid = uidStr and tonumber(uidStr) or nil
                local clean = string.gsub(cashLbl.Text or "", "%D", "")
                local cashNum = tonumber(clean)
                if uid and cashNum then
                    byUserId[uid] = { cash = cashNum }
                end
            end
        end
    end
    return byUserId
end

local function getRoleColor(hasRole, dept)
