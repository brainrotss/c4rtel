local function handleMessage(name, text, userId)
    if chatPaused then return end
    if not userId or not name or not text then return end

    local entry = chatData[userId]
    if not entry then
        entry = { name = name, msgs = {} }
        chatData[userId] = entry
        ensurePlayerButton(userId, name)
    end

    local timestamp = formatTime()
    local color = classifyColor(name, text)

    table.insert(entry.msgs, {
        time = timestamp,
        text = text,
        color = color,
    })

    while #entry.msgs > MAX_MSGS_PER_PLAYER do
        table.remove(entry.msgs, 1)
    end

    chatDirty[userId] = true
    addFeedRow(name, text, color, timestamp)
end

