local function refreshRoster(silent)
    local cashMap = readCashLeaderboard()
    local rpd = Remotes and Remotes:FindFirstChild("RequestPlayerData")
    if not rpd or not rpd:IsA("RemoteFunction") then
        if not silent then setStatus("RequestPlayerData not found") end
        return
    end
    local ok, result = pcall(function() return rpd:InvokeServer() end)
    if not ok or type(result) ~= "table" then
        if not silent then setStatus("Roster failed") end
        return
    end
    local seen = {}
    for userIdStr, data in pairs(result) do
        local userId = tonumber(userIdStr)
        if userId and type(data) == "table" then
            seen[userId] = true
            local cashEntry = cashMap[userId]
            data.Cash = cashEntry and cashEntry.cash or nil
            rosterData[userId] = data
            if not rosterButtons[userId] then
                addPlayerRow(userId, data)
            else
                local btn = rosterButtons[userId]
                btn.Text = string.format("  %-20s  %s", data.Name or "?", data.Role or "(no role)")
                btn.TextColor3 = getRoleColor(data.HasRole, data.Department)
            end
        end
    end
    for userId in pairs(rosterButtons) do
        if not seen[userId] then
            removePlayerRow(userId)
            rosterData[userId] = nil
        end
    end
    applyInfoFilter()
    if not silent then setStatus("Roster refreshed") end
end

